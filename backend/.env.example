# Neon pooled connection string (Connect > Pooled connection on the Neon dashboard)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname

# Used to sign admin/guest JWTs — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Minutes a pending_payment booking holds a room before its hold expires
PENDING_PAYMENT_EXPIRY_MINUTES=15

# Cookies require Secure to be sent over HTTPS; browsers make an exception for
# http://localhost, so this can stay true in local dev too. Set false only for
# a non-localhost, non-HTTPS deployment.
COOKIE_SECURE=true

# No Razorpay (or other gateway) keys are wired up yet — these stub endpoints
# fake a successful payment/refund. Must be false before real money moves.
PAYMENTS_STUB_MODE=true

PORT=8000
