# Neon pooled connection string (Connect > Pooled connection on the Neon dashboard)
DATABASE_URL=postgresql+asyncpg://user:password@host-pooler.region.aws.neon.tech/dbname

# Used to sign admin JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
